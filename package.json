{
  "name": "agentcoder",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agentcoder": "./bin/agentcoder.js"
  },
  "files": [
    "bin",
    "bridge/dist"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freeappstore-online/agentcoder.git"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "scripts": {
    "dev": "pnpm --filter @agentcoder/web dev",
    "build": "pnpm --filter @agentcoder/web build",
    "build:bridge": "pnpm --filter agentcoder-bridge build",
    "preview": "pnpm --filter @agentcoder/web preview",
    "typecheck": "pnpm --filter @agentcoder/web exec tsc -b",
    "test": "pnpm --filter @agentcoder/web exec tsc -b",
    "lint": "biome check .",
    "prepare": "cd bridge && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/ws": "^8.5.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  }
}
